#!/bin/sh
# Single seam between automation (CI, hooks, scripts/agent) and the toolchain.
# Nothing outside this file should know the project is written in Rust.
set -eu

cd "$(dirname "$0")/.."

usage() {
  cat <<'USAGE'
usage: scripts/task <target>

  fmt        format in place
  fmt:check  verify formatting, non-zero on drift
  lint       lint, warnings are errors
  test       full test suite
  build      compile
  check      fmt:check && lint && test && build
USAGE
}

run() {
  printf '==> %s\n' "$*"
  "$@"
}

case "${1:-}" in
  fmt)       run cargo fmt --all ;;
  fmt:check) run cargo fmt --all --check ;;
  lint)      run cargo clippy --all-targets --all-features --locked -- -D warnings ;;
  test)      run cargo test --all-targets --all-features --locked ;;
  build)     run cargo build --all-targets --all-features --locked ;;
  check)
    "$0" fmt:check
    "$0" lint
    "$0" test
    "$0" build
    ;;
  -h|--help|help|'') usage; [ -n "${1:-}" ] || exit 2 ;;
  *) printf 'scripts/task: unknown target: %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
esac
